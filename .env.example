# Apex Clip Scale — environment variables (NAMES ONLY, no values).
# Copy to `.env` for local development and fill in real values there.
# `.env` is gitignored and must never be committed (see H-34).
# Server-side secrets below are NOT set here — they are set in the
# Supabase dashboard (Project Settings → Edge Functions → Secrets).
# See docs/SECRETS.md for the full inventory.

# --- Frontend (Vite build env; set in .env locally, build env in CI/Lovable) ---
# Supabase project URL (public).
VITE_SUPABASE_URL=
# Supabase publishable (anon) key (public by design, but still rotate if ever exposed in git history).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase project ref. NOTE: never read anywhere in code — kept only for
# reference / tooling that expects it. Safe to leave empty.
VITE_SUPABASE_PROJECT_ID=

# --- Server (Supabase dashboard secrets — DO NOT put these in .env) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# APIFY_API_TOKEN=
# SCRAPE_CREATORS_API_KEY=
# TIKTOK_API_KEY=
# INSTAGRAM_API_KEY=
# YOUTUBE_API_KEY=
# UPDATE_VIEWS_CRON_SECRET=
# METRICS_SIGNING_KEY=
